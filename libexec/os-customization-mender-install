#!/usr/bin/env python3

import argparse
import os
import subprocess
import sys
from pathlib import Path


def _prepend_pythonpath() -> None:
    env_pythonpath = os.environ.get("PYTHONPATH", "")
    for entry in reversed([item for item in env_pythonpath.split(":") if item]):
        if entry not in sys.path:
            sys.path.insert(0, entry)

    script_path = Path(__file__).resolve()
    candidate_paths = [
        script_path.parent.parent / "lib" / "os-customization" / "python",
        Path("/usr/lib/os-customization/python"),
        Path("/data/os-customization-tools/lib/os-customization/python"),
    ]
    for candidate in candidate_paths:
        candidate_str = str(candidate)
        if candidate.is_dir() and candidate_str not in sys.path:
            sys.path.insert(0, candidate_str)
            break


_prepend_pythonpath()

from os_customization.manager import CustomizationError, CustomizationManager


def main() -> int:
    parser = argparse.ArgumentParser(prog="os-customization-mender-install")
    parser.add_argument("directory", help="Extracted customization payload directory")
    parser.add_argument("--root", default=os.environ.get("OS_CUSTOMIZATION_ROOT", "/data/os-customization"))
    parser.add_argument("--core-os-version", default=os.environ.get("OS_CUSTOMIZATION_CORE_OS_VERSION"))
    parser.add_argument("--issue-path", default=os.environ.get("OS_CUSTOMIZATION_ISSUE_PATH", "/etc/issue"))
    parser.add_argument("--no-reboot", action="store_true")
    args = parser.parse_args()

    manager = CustomizationManager(root=Path(args.root), issue_path=Path(args.issue_path))
    try:
        with manager.operation_lock():
            result = manager.install_payload(Path(args.directory), current_core_os=args.core_os_version)
        print(result)
        if not args.no_reboot:
            subprocess.run(["systemctl", "reboot"], check=True)
        return 0
    except (CustomizationError, subprocess.CalledProcessError) as exc:
        print(f"os-customization-mender-install: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
